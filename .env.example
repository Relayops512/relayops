# Copy to .env and adjust as needed.
# `npm run dev` works with these defaults.

# Optional local Prisma/SQLite (the deployed app uses an in-memory demo store).
DATABASE_URL="file:./dev.db"

# Generate a long random string for any shared/pilot deploy:
#   openssl rand -base64 32
AUTH_SECRET="relayops-dev-secret-change-me-for-pilot"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Production (Vercel):
# AUTH_URL="https://relayops.vercel.app"
# AUTH_SECRET=<openssl rand -base64 32>
# DATABASE_URL is unused on Vercel — demo fleet lives in memory.

# Samsara OAuth (optional — demo login and CSV work without these)
# Create an app in Samsara: Settings → OAuth 2.0 Apps
# Redirect URL must match SAMSARA_REDIRECT_URI exactly.
# Read scopes: Vehicles, Drivers, Assignments, Vehicle Statistics, ELD Compliance Settings (US)
SAMSARA_CLIENT_ID=""
SAMSARA_CLIENT_SECRET=""
SAMSARA_REDIRECT_URI="http://localhost:3000/api/integrations/samsara/callback"
# Optional EU/CA API host:
# SAMSARA_API_BASE="https://api.samsara.com"
# Optional extra encryption key (defaults to AUTH_SECRET):
# SAMSARA_ENCRYPTION_KEY=""

