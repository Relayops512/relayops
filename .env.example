# Copy to .env and adjust as needed.
# `npm run dev` works with these defaults.

DATABASE_URL="file:./dev.db"

# Generate a long random string for any shared/pilot deploy:
#   openssl rand -base64 32
AUTH_SECRET="relayops-dev-secret-change-me-for-pilot"
AUTH_URL="http://localhost:3000"

# Optional: set on Vercel to your production URL
# AUTH_URL="https://your-app.vercel.app"
